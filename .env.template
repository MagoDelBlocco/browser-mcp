# Google Custom Search API (required)
# Get at: https://developers.google.com/custom-search/v1/overview
GOOGLE_API_KEY=
GOOGLE_CX=

# Hugging Face token (required for gated models like embeddinggemma)
# Get at: https://huggingface.co/settings/tokens
HF_TOKEN=

# Firecrawl URL (optional, defaults to host.docker.internal:13002)
# FIRECRAWL_URL=http://host.docker.internal:13002

# Embedding model (optional)
# EMBEDDING_MODEL=google/embeddinggemma-300m

# Reranking model (optional)
# RERANKING_MODEL=cross-encoder/ettin-reranker-400m-v1

# Embedding batch size (optional)
# EMBED_BATCH_SIZE=128
