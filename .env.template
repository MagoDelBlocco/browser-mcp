# --- Search (DuckDuckGo, no API key needed) ---
# SEARCH_REGION=us-en
# SEARCH_SAFESEARCH=moderate      # on | moderate | off
# SEARCH_BACKEND=auto             # ddgs backend(s), e.g. "duckduckgo,brave"
# SEARCH_RETRIES=3                # retries with backoff on rate limits

# --- Fetch (Crawl4AI / headless Chromium) ---
# FETCH_CONCURRENCY=4             # pages crawled in parallel
# PAGE_TIMEOUT_MS=25000           # per-page navigation timeout
# FETCH_TIMEOUT=120               # whole-batch ceiling, seconds (partial results are kept)
# CHECK_ROBOTS_TXT=false          # honor robots.txt before fetching
# BROWSER_IDLE_TIMEOUT=300        # close the warm browser after N idle seconds
# MEMORY_THRESHOLD_PERCENT=85     # dispatcher backs off above this; reads HOST ram
# USER_AGENT=                     # identifies the crawler; default names this project

# --- PDFs ---
# PDF_ENABLED=true                # route application/pdf URLs to the PDF extractor
# CONTENT_TYPE_PROBE_TIMEOUT=8    # HEAD probe used to detect PDFs, seconds

# --- Page cache ---
# PAGE_CACHE_TTL=900              # seconds; 0 disables caching entirely
# PAGE_CACHE_MAX_ENTRIES=256      # LRU ceiling

# --- Output shaping ---
# MAX_LINKS_PER_PAGE=25           # outbound links returned per page; 0 disables
# MAX_FULL_TEXT_LENGTH=60000      # ceiling for full_text mode
# DEDUPE_THRESHOLD=0.8            # near-duplicate Jaccard cutoff; 1.0 disables
# DEDUPE_CANDIDATES=150           # how many top chunks get compared

# --- Politeness ---
# RATE_LIMIT_ENABLED=true         # per-domain spacing + backoff on 429/503
# RATE_LIMIT_MIN_DELAY=0.5
# RATE_LIMIT_MAX_DELAY=1.5
# RATE_LIMIT_BACKOFF_CAP=30

# --- Sampling / multi-hop research ---
# Sampling borrows the CLIENT's model (no API key here) for query expansion, result
# triage and coverage checks. Clients without sampling fall back automatically.
# SAMPLING_ENABLED=true
# SAMPLING_TIMEOUT=30
# MAX_RESEARCH_DEPTH=3            # ceiling on research(depth=...)

# --- Network safety ---
# Fetch targets come from the model (`fetch`) or from search results (`research`).
# With this off, URLs resolving to loopback/private/link-local addresses are refused,
# which blocks cloud metadata endpoints (169.254.169.254) and internal services.
# ALLOW_PRIVATE_URLS=false

# --- Authenticated fetching ---
# Credentials are configured HERE, never passed as tool arguments. Keyed by host;
# a leading dot covers subdomains. Withheld from plaintext http:// by default.
# FETCH_CREDENTIALS={"docs.example.com": {"Authorization": "Bearer ..."}}
# FETCH_CREDENTIALS_FILE=/run/secrets/credentials.json
# ALLOW_INSECURE_CREDENTIALS=false

# --- Serving ---
# BIND_HOST=0.0.0.0               # inside the container; compose publishes to loopback
# PORT=8000
# AUTH_TOKEN=                     # set a bearer token before exposing beyond localhost
